    {
      "id": 10,
      "type": "table",
      "title": "Recent Transactions",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "upiguard-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "upiguard-timescaledb"
          },
          "rawSql": "SELECT transaction_time AS \"Time\", transaction_id AS \"Transaction ID\", account_id AS \"Account ID\", transaction_amount AS \"Amount (\u20b9)\", city AS \"City\", fraud_prediction AS \"Fraud Prediction\", fraud_probability AS \"Fraud Probability\", risk_level AS \"Risk Level\" FROM transactions ORDER BY transaction_time DESC LIMIT 25;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
