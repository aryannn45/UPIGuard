          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "upiguard-timescaledb"
          },
          "rawSql": "SELECT COALESCE(SUM(transaction_amount), 0) AS total_transaction_value FROM transactions;",
          "format": "table"
