        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Fraud by City",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "upiguard-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "upiguard-timescaledb"
          },
          "rawSql": "SELECT city AS \"City\", COUNT(*) FILTER (WHERE fraud_prediction = 1) AS \"Fraudulent Transactions\" FROM transactions GROUP BY city ORDER BY 2 DESC, 1;",
