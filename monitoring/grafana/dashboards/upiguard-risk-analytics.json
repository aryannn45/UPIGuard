    {
      "id": 5,
      "type": "stat",
      "title": "Total Transaction Value (\u20b9)",
      "description": "Total amount across all transactions recorded in the database.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "upiguard-timescaledb"
