      "options": {
        "orientation": "horizontal",
        "xField": "City",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Risk Distribution",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "upiguard-timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "upiguard-timescaledb"
          },
          "rawSql": "SELECT COUNT(*) FILTER (WHERE risk_level = 'LOW') AS \"LOW\", COUNT(*) FILTER (WHERE risk_level = 'MEDIUM') AS \"MEDIUM\", COUNT(*) FILTER (WHERE risk_level = 'HIGH') AS \"HIGH\" FROM transactions;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
